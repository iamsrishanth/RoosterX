# Supabase Postgres connection for the franchise enquiry form.
# Get values from the Supabase dashboard -> Project Settings -> Database.
# DATABASE_URL uses the transaction pooler (port 6543, pgbouncer=true) for serverless runtimes.
# DIRECT_URL uses port 5432 for schema pushes / migrations.
DATABASE_URL="postgres://USER.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgres://USER.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
